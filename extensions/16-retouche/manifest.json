{
  "manifest_version": 3,
  "name": "Aruzen · Retouche",
  "version": "1.0.0",
  "description": "Gomme intelligente : peins une zone (filigrane, date, logo, objet, défaut) et l'image se reconstitue d'après son contenu, en local. Pour tes images et celles dont tu as les droits.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Ouvrir l'atelier Retouche",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}
