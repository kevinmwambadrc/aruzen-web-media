{
  "manifest_version": 3,
  "name": "Aruzen · Sous-titres & Miniatures",
  "version": "1.0.0",
  "description": "Télécharge les sous-titres (SRT, toutes langues, y compris automatiques) et la miniature HD d'une vidéo.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage"
  ],
  "key": ""
}
