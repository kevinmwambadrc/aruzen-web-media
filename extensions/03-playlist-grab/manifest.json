{
  "manifest_version": 3,
  "name": "Aruzen · Playlist Grab",
  "version": "1.0.0",
  "description": "Télécharge une playlist, un album ou une chaîne entière (vidéo ou audio), avec choix des éléments.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "key": ""
}
