{
  "manifest_version": 3,
  "name": "Aruzen · Workspace",
  "version": "1.0.0",
  "description": "Capture rapide de tâches (avec envoi facultatif vers un outil de notes), chronomètre par client avec feuille de temps et export, bibliothèque de prompts à variables.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "workspace.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms",
    "idle",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      }
    },
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Démarrer / arrêter le chronomètre"
    }
  },
  "key": ""
}
