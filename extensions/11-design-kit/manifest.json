{
  "manifest_version": 3,
  "name": "Aruzen · Design Kit",
  "version": "1.0.0",
  "description": "Pipette de charte (couleurs, polices, export .ase Illustrator), SVG Grabber, moodboard, règle, grille et captures responsive.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "measure": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Activer / couper la règle"
    }
  },
  "key": ""
}
