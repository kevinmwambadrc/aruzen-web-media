{
  "manifest_version": 3,
  "name": "Aruzen · Research",
  "version": "1.0.0",
  "description": "Surligneur et carnet de recherche (citations, notes, export Markdown), sessions d'onglets par projet, libération de mémoire et veille de pages.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "notebook.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "tabs",
    "alarms",
    "notifications",
    "offscreen",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "highlight": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Surligner la sélection"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      }
    }
  },
  "key": ""
}
